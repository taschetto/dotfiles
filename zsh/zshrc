# Canix dev helper: start backend, frontend, and sidekiq in tmux
function canix-dev() {
  local root="$CANIX_MONOREPO_ROOT"
  local backend_dir="$root/backend"
  local frontend_dir="$root/web"
  local session="canix"

  if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux is required. Install with: brew install tmux"
    return 1
  fi

  if [[ ! -d "$backend_dir" || ! -d "$frontend_dir" ]]; then
    echo "Expected directories not found under $root"
    return 1
  fi

  # Ensure Colima is running (Docker runtime)
  if ! colima status &>/dev/null; then
    echo "Starting Colima..."
    colima start
  fi

  # Ensure docker-compose services (postgres, redis) are up
  if ! docker compose -f "$root/docker-compose.yml" ps --status running --quiet 2>/dev/null | grep -q .; then
    echo "Starting docker-compose services..."
    docker compose -f "$root/docker-compose.yml" up -d
  fi

  # Kill existing session to ensure fresh start
  tmux kill-session -t "$session" 2>/dev/null

  # Kill any existing processes on the ports we need
  kill -9 $(lsof -ti :3000) 2>/dev/null
  kill -9 $(lsof -ti :3001) 2>/dev/null
  pkill -f 'sidekiq.*config/sidekiq.dev.yml' 2>/dev/null

  # Create session with first pane (backend)
  tmux new-session -d -s "$session" -n dev -c "$backend_dir"

  # Split horizontally for frontend pane
  tmux split-window -h -t "$session:dev" -c "$frontend_dir"

  # Split the first pane vertically for sidekiq
  tmux split-window -v -t "$session:dev.0" -c "$backend_dir"

  # Arrange panes vertically (stacked)
  tmux select-layout -t "$session:dev" even-vertical

  # Send commands to each pane
  tmux send-keys -t "$session:dev.0" 'bundle exec rails s' C-m
  tmux send-keys -t "$session:dev.1" 'bundle exec sidekiq -C config/sidekiq.dev.yml' C-m
  tmux send-keys -t "$session:dev.2" 'yarn start:local' C-m

  # Focus on backend pane and attach
  tmux select-pane -t "$session:dev.0"
  tmux attach -t "$session"
}

# alias canix='canix-dev'
alias canix-stop='tmux kill-session -t canix'

# https://github.com/ruby/openssl/issues/949#issuecomment-3394091087
export LDFLAGS="-L/opt/homebrew/opt/openssl@3.5/lib"
export CPPFLAGS="-I/opt/homebrew/opt/openssl@3.5/include"
